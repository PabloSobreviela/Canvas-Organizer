# Backend Environment Variables Template
# Copy to .env and fill in your values

# ==============================================
# RUNTIME MODE (see backend/app_config.py)
# ==============================================
# APP_ENV: "development" (default) or "production". Production ALWAYS runs in
# cloud mode (Supabase + Canvas OAuth + auth) and fails closed if misconfigured.
# APP_ENV=development
# CLOUD_MODE: force cloud mode in development (default false). On Cloud Run /
# production this is implied. (USE_FIRESTORE is a deprecated alias for CLOUD_MODE.)
# CLOUD_MODE=false

# ==============================================
# SUPABASE
# ==============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=course-files

# ==============================================
# CANVAS OAUTH2
# ==============================================
# Developer key from Instructure / university admin (GT OIT)
CANVAS_OAUTH_CLIENT_ID=placeholder-until-GT-OIT-provides
CANVAS_OAUTH_CLIENT_SECRET=placeholder-until-GT-OIT-provides
CANVAS_INSTANCE_URL=https://gatech.instructure.com
CANVAS_OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/canvas/callback
# Space-separated read-only scopes (must match GT developer key configuration).
# Keep this aligned with auth.py::_DEFAULT_CANVAS_SCOPES and enable
# allow_includes on the developer key for assignment submission state.
# CANVAS_OAUTH_SCOPES=url:GET|/api/v1/users/self url:GET|/api/v1/courses ...

# Where to redirect after successful OAuth login
FRONTEND_URL=http://localhost:3000

# ==============================================
# SESSION
# ==============================================
# Secret key for signing JWT session tokens (required in production, min 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-to-a-random-secret
# SESSION_COOKIE_NAME=canvassync_session
# SESSION_TOKEN_EXPIRY_HOURS=24

# ==============================================
# PRODUCTION SAFETY GATES
# ==============================================
# ENABLE_DEMO_SESSION=false
# ENABLE_AI_RESOLVE=false
# RATELIMIT_STORAGE_URI=redis://host:6379/0
# MIN_SECONDS_BETWEEN_COURSE_SYNCS=30
# CANVAS_TOKEN_REFRESH_BUFFER_SECONDS=300
# LEGAL_CONSENT_VERSION=2026-06-19

# ==============================================
# DATA HANDLING (minimization & retention) - see docs/OIT_READINESS_AUDIT.md
# ==============================================
# Persist raw Canvas API payloads (debug only). OFF in production by default.
# STORE_RAW_CANVAS_JSON=false
# Retention windows in days (0 disables purging for that category).
# COURSE_FILE_TEXT_RETENTION_DAYS=180
# ANNOUNCEMENT_RETENTION_DAYS=180
# ASSIGNMENT_RETENTION_DAYS=180
# COURSE_RETENTION_DAYS=180
# SYLLABUS_RULES_RETENTION_DAYS=180
# INACTIVE_USER_CONTENT_PURGE_DAYS=180

# ==============================================
# LLM INFERENCE (direct DeepInfra; no gateway or alternate-provider fallback)
# ==============================================
# Required in production only when ENABLE_AI_RESOLVE=true.
DEEPINFRA_API_KEY=your-deepinfra-api-key
LLM_BASE_URL=https://api.deepinfra.com/v1/openai

# Production model:
# MODEL_NAME=Qwen/Qwen3-235B-A22B-Instruct-2507
# AI_TEMPERATURE=0.1
# AI_TOP_P=0.9

# Parallel AI resolve across independent course groups (max concurrent LLM calls).
# Same class-code sections (lecture + lab) share one merged call; parallelism is across groups.
# AI_MAX_CONCURRENCY=10
# AI_TRANSIENT_MAX_RETRIES=2

# ==============================================
# SERVER SETTINGS
# ==============================================
PORT=5000
FLASK_DEBUG=false

# ==============================================
# CANVAS API SETTINGS
# ==============================================
# Security: Restrict which Canvas hostnames are allowed as base URLs.
# CANVAS_ALLOWED_HOST_PATTERNS=*.instructure.com

# Timeout (seconds) for outbound Canvas requests.
# CANVAS_REQUEST_TIMEOUT_SECONDS=20

# Identifies the application to Canvas without including user information.
# CANVASSYNC_USER_AGENT=CanvasSync/1.0 (Georgia Tech student-built app; canvassync@gatech.edu)

# Hourly sync limit per authenticated user.
# COURSE_SYNC_RATE_LIMIT_PER_HOUR=100

# ==============================================
# ENCRYPTION
# ==============================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt Canvas OAuth tokens in the database.
CANVAS_TOKEN_ENCRYPTION_KEY=your-fernet-key-here
